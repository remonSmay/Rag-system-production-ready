APP_NAME=mini-rag
APP_VERSION=0.1.0

# Upload settings
FILE_ALLOWED_TYPES='["application/pdf","text/plain"]'
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=51200

# MongoDB
MONGODB_URL=mongodb://mini_rag_user:mini_rag_password@localhost:27017/?authSource=admin
MONGODB_DATABASE=mini_rag

# LLM providers: OPENAI or COHERE
GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=OPENAI

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# Cohere provider
COHERE_API_KEY=

# Model settings
GENERATION_MODEL_ID=
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_SIZE=384
INPUT_DEFAULT_MAX_CHARACTERS=1000
GENERATION_DEFAULT_MAX_TOKENS=1000
GENERATION_DEFAULT_TEMPERATURE=0.1

# Vector database
VECTOR_DB_BACKEND=QDRANT
VECTOR_DB_DISTANCE_METHOD=COSINE
VECTOR_DB_PATH=qdrant_db

# Prompt templates
PRIMARY_LANG=en
DEFAULT_LANG=en
